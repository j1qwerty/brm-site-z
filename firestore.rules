rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can submit a contact message; only signed-in admins can read/update.
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Anyone can submit an inquiry; only signed-in admins can read/update.
    match /inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Public can READ cms_content (live overrides only).
    // Writes are restricted to signed-in admins (Google sign-in).
    match /cms_content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public can READ cms_items. Writes are restricted to signed-in admins.
    match /cms_items/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public can READ cms_settings. Writes are restricted to signed-in admins.
    match /cms_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // History is admin-only.
    match /cms_history/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
