# Firebase configuration for BRM International School
# Copy this file to .env.local and fill in your Firebase project keys.
# You can find these values in: Firebase Console -> Project Settings -> General -> Your apps -> Web app.
#
# All VITE_ keys are PUBLIC by Firebase design (they identify the project,
# not authenticate). Security is enforced via Firestore Security Rules, not by
# hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin panel password. Defaults to "brm-admin" if not set.
# This is a convenience gate, not a security boundary. Use Google sign-in
# (Firebase Auth) for real protection.
VITE_ADMIN_PASSWORD=
